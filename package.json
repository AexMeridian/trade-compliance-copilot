{
  "name": "aex-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && wrangler dev",
    "build:frontend": "npm run build --workspace frontend",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace frontend",
    "test:unit": "tsx tests/duty-stack.test.ts && tsx tests/connections.test.ts && tsx tests/scheduler.test.ts && tsx tests/feed.test.ts && tsx tests/sanction-counts.test.ts && tsx tests/naming.test.ts && tsx tests/csv.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply trade-compliance-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trade-compliance-db --remote",
    "seed:hts": "tsx scripts/fetch-hts.ts",
    "seed:schedule-b": "tsx scripts/build-schedule-b.ts",
    "seed:xref": "tsx scripts/seed-schedule-b-xref.ts",
    "seed:ofac": "tsx scripts/fetch-ofac-sdn.ts",
    "seed:csl": "tsx scripts/fetch-csl.ts",
    "seed:samples": "tsx scripts/seed-sample-cases.ts",
    "seed:load-local": "tsx scripts/load-batches.ts --local",
    "seed:load-remote": "tsx scripts/load-batches.ts --remote",
    "seed:path-index": "tsx scripts/rebuild-hts-path-index.ts",
    "test:golden": "tsx tests/run-golden-cases.ts",
    "test:a11y": "node tests/a11y-routes.mjs",
    "test:smoke": "node tests/smoke-routes.mjs",
    "lint": "npm run lint --workspace frontend",
    "check": "npm run typecheck && npm run test:unit && npm run build:frontend"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^22.9.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
}
