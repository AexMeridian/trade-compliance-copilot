{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-compliance-copilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Real remote database, created via `wrangler d1 create trade-compliance-db`
  // on 2026-09-23. `wrangler dev` (no --remote flag) still simulates D1 locally
  // regardless of this ID, using a local SQLite file under .wrangler/state --
  // re-run the seed steps in README.md if you need local data again.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-compliance-db",
      "database_id": "b5d53fbc-0e74-4ab3-83dd-52a577f59a35",
      "migrations_dir": "migrations"
    }
  ],

  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rss.xml", "/atom.xml", "/feed.json"]
  },

  // Caps how often one client IP can hit the 4 routes that call the Anthropic
  // API (classification/origin/screening/determination) -- this is a public
  // demo Worker with no auth, so without this a bot could hammer those routes
  // and run up unbounded Claude API spend. 20 req/60s per IP comfortably
  // covers a real user working through several cases; see src/index.ts.
  "ratelimits": [
    {
      "name": "CLAUDE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    // Generous per-IP cap on the public Pulse read API (src/index.ts): a page
    // load makes only a couple of calls, so this never touches a real reader
    // but stops one client from hammering D1 and the Workers request quota.
    // Cap on the few routes that write to the database for an anonymous visitor
    // (creating a calculator case, saving a citable snapshot): 10 per minute per IP.
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MISS_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 40,
        "period": 60
      }
    },
    {
      "name": "PULSE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],

  // Switches for the two third-party inputs whose terms matter most if the
  // site is ever run commercially. "off" turns the feature off without a
  // code change: NEWS_IMAGES hides publishers' lead photos, MARKET_QUOTES
  // stops fetching and showing the Yahoo Finance stock/commodity tiles
  // (currencies from the ECB are unaffected). See README "Before you launch".
  "vars": {
    "NEWS_IMAGES": "off",
    "MARKET_QUOTES": "off",
    "CLAUDE_DAILY_CAP": "300"
  },

  "observability": {
    "enabled": true
  },

  // Auto-refresh schedule (src/scheduled.ts). Workers Free allows 5 cron triggers
  // and caps each invocation at 50 outbound requests and 50 database queries, so
  // the work is split across three triggers, each with its own budget:
  //   05:00 UTC  the daily Pulse jobs (Federal Register, ECB rates, news, macro,
  //              COFER, Treasury, commodities, case expiry)
  //   06:00 UTC  the weekly reference-table reloads that are due (SDN, CSL, UN, UK,
  //              GTA, WRO, HTS, Schedule B, xref), a few at a time so no day
  //              exceeds D1's free cap of 100,000 rows written
  //   07:00 UTC  the weekly country indicators that are due (World Bank, UN voting,
  //              UNESCO, UNHCR, Nobel, OCHA), at most 40 requests a day
  // Curated legal content (USMCA rules, tariff overlays, country chart, ECCN) is
  // NOT on this schedule -- see the comment at the top of src/scheduled.ts.
  "triggers": {
    "crons": ["0 5 * * *", "0 6 * * *", "0 7 * * *"]
  }
}
