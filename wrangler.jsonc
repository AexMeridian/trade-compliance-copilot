{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-compliance-copilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Real remote database, created via `wrangler d1 create trade-compliance-db`
  // on 2026-09-23. `wrangler dev` (no --remote flag) still simulates D1 locally
  // regardless of this ID, using a local SQLite file under .wrangler/state --
  // re-run the seed steps in README.md if you need local data again.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-compliance-db",
      "database_id": "b5d53fbc-0e74-4ab3-83dd-52a577f59a35",
      "migrations_dir": "migrations"
    }
  ],

  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Caps how often one client IP can hit the 4 routes that call the Anthropic
  // API (classification/origin/screening/determination) -- this is a public
  // demo Worker with no auth, so without this a bot could hammer those routes
  // and run up unbounded Claude API spend. 20 req/60s per IP comfortably
  // covers a real user working through several cases; see src/index.ts.
  "ratelimits": [
    {
      "name": "CLAUDE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    // Generous per-IP cap on the public Pulse read API (src/index.ts): a page
    // load makes only a couple of calls, so this never touches a real reader
    // but stops one client from hammering D1 and the Workers request quota.
    {
      "name": "PULSE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],

  // Switches for the two third-party inputs whose terms matter most if the
  // site is ever run commercially. "off" turns the feature off without a
  // code change: NEWS_IMAGES hides publishers' lead photos, MARKET_QUOTES
  // stops fetching and showing the Yahoo Finance stock/commodity tiles
  // (currencies from the ECB are unaffected). See README "Before you launch".
  "vars": {
    "NEWS_IMAGES": "on",
    "MARKET_QUOTES": "on"
  },

  "observability": {
    "enabled": true
  },

  // Auto-refresh schedule (src/scheduled.ts). Exactly 5 entries -- Workers
  // Free caps an account at 5 cron triggers total, so SDN and CSL share the
  // "0 6 * * 1" slot (src/scheduled.ts dispatches both from one trigger)
  // rather than this app needing a 6th slot or a plan upgrade just to add
  // Trade Policy Pulse's daily sync. Pulse (live Federal Register feed,
  // src/lib/pulse/sync.ts) is the only daily job -- it's a small incremental
  // upsert, not a full-table reload, so it doesn't carry the D1 write-quota
  // risk below. The bulk government reference tables (HTS, Schedule B,
  // xref, SDN, CSL) are weekly, staggered Monday mornings so xref only
  // rebuilds after both schedules it joins are current -- SDN/CSL were
  // moved off a daily schedule after a D1 write-quota incident (see
  // README's "Refreshing the data"): each of those jobs does a full
  // DELETE + full re-INSERT, and D1's free-tier plan caps writes at
  // 100,000 rows/day account-wide. Curated legal content (USMCA rules,
  // tariff overlays, country chart, ECCN) is NOT on this schedule -- see
  // the comment at the top of src/scheduled.ts for why.
  "triggers": {
    "crons": [
      "0 5 * * *",
      "0 6 * * 1",
      "0 7 * * 1",
      "30 7 * * 1",
      "0 8 * * 1"
    ]
  }
}
