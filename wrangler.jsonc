{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-compliance-copilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // NOTE: this is a placeholder database_id sufficient for local `wrangler dev --local`
  // and `wrangler d1 migrations apply --local`. Before deploying remotely, run
  // `wrangler login` then `wrangler d1 create trade-compliance-db` and replace both
  // the database_id below with the real one it prints. See README.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-compliance-db",
      "database_id": "e83d35a0-48c9-4aa5-a6b5-2e8d9db2bdd0",
      "migrations_dir": "migrations"
    }
  ],

  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Caps how often one client IP can hit the 4 routes that call the Anthropic
  // API (classification/origin/screening/determination) -- this is a public
  // demo Worker with no auth, so without this a bot could hammer those routes
  // and run up unbounded Claude API spend. 20 req/60s per IP comfortably
  // covers a real user working through several cases; see src/index.ts.
  "ratelimits": [
    {
      "name": "CLAUDE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": true
  }
}
